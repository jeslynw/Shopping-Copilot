# Copy to .env (git-ignored) or export in your shell. The scored run works WITHOUT any of these (deterministic core);
# with a key present the Claude layer switches on automatically (grounded extraction fallback + message polish).
ANTHROPIC_API_KEY=
COPILOT_LLM=                      # 1 = force on, 0 = force off; unset = on iff ANTHROPIC_API_KEY is set
COPILOT_OFFLINE=0                 # 1 = hard kill switch for any network use (tests also set ANTHROPIC_BASE_URL=http://127.0.0.1:9)
COPILOT_LLM_EXTRACT_MODEL=claude-haiku-4-5   # extraction / rerank (fast, structured JSON)
COPILOT_LLM_MODEL=claude-sonnet-5            # message polish
