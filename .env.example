# Copy to .env (git-ignored; the agent reads it automatically) or export in your shell. The scored run works WITHOUT any
# of these (deterministic core); with a key present the LLM layer switches on (grounded extraction fallback + message polish).
OPENAI_API_KEY=                   # → provider openai  (defaults: gpt-4.1-mini for extraction and polish)
ANTHROPIC_API_KEY=                # → provider anthropic (defaults: claude-haiku-4-5 extraction, claude-sonnet-5 polish)
COPILOT_LLM_PROVIDER=             # openai | anthropic — only needed if both keys are set
COPILOT_LLM=                      # 1 = force on, 0 = force off; unset = on iff a key is set
COPILOT_OFFLINE=0                 # 1 = hard kill switch for any network use
COPILOT_LLM_EXTRACT_MODEL=        # override the extraction / rerank model
COPILOT_LLM_MODEL=                # override the polish model
