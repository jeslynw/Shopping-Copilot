# Copy to .env (git-ignored). Only needed for the OPTIONAL Claude polisher / dev tooling — the scored run needs none of these.
ANTHROPIC_API_KEY=
COPILOT_LLM=0            # 1 = rewrite the customer-facing message with Claude (one call/turn, 1.5 s budget, breaker)
COPILOT_LLM_MODEL=claude-opus-5
COPILOT_OFFLINE=0        # 1 = hard kill switch for any network use (tests also set ANTHROPIC_BASE_URL=http://127.0.0.1:9)
